{
  "name": "portfolio-secure",
  "version": "4.0.0",
  "description": "Professional & Secure Liquid Glass Portfolio — React SPA + Express API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "build": "cd client && npm install && npx vite build",
    "dev:client": "cd client && npx vite --host",
    "clean": "rm -rf node_modules client/node_modules client/dist"
  },
  "keywords": [
    "portfolio",
    "secure",
    "express",
    "liquid-glass",
    "react"
  ],
  "author": "AliEbrahimi",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react-router-dom": "^6.30.4",
    "uuid": "^9.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0"
  }
